name: Test

# Runs the full test suite on every push to main and on every pull request.
# Free for private repos within the 2000 min/month tier.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch: # allow manual runs from the Actions tab

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browser
        run: npx playwright install chromium --with-deps

      # The Playwright config auto-starts the server on port 3001 with
      # node --env-file=.env. CI doesn't have a .env; the server checks
      # ANTHROPIC_API_KEY at startup and refuses to boot without it.
      # Tests mock all SSE traffic, so we use a fake key just to satisfy
      # the boot check.
      - name: Create CI .env
        run: echo "ANTHROPIC_API_KEY=ci-fake-key-not-used-by-tests" > .env

      - name: Unit tests
        run: npm run test:unit

      - name: Playwright UI tests
        run: npm run test:ui

      - name: Upload Playwright report on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 14
