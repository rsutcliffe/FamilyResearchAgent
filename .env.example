# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is committed as a template.

# Required: Anthropic API key from https://console.anthropic.com/settings/keys
# Must start with "sk-ant-api03-"
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Optional: model override. Defaults to claude-sonnet-4-6.
# PRD §7.2 specifies claude-sonnet-4-20250514; either works.
# MODEL=claude-sonnet-4-6

# Optional: which test individual the smoke script runs against.
# Choices: ann_sweeting (default) | john_sutcliffe_1560
# INDIVIDUAL=ann_sweeting

# Optional: which KB context profile to send with the smoke-test request.
# Choices: empty (default) | ann_sweeting_anchors
# KB=empty

# Optional: spend controls.
# Pricing in USD per million tokens (defaults are claude-sonnet-4-6 list rates).
# PRICE_INPUT_PER_M=3
# PRICE_OUTPUT_PER_M=15
# PRICE_CACHE_READ_PER_M=0.3
# PRICE_CACHE_WRITE_PER_M=3.75
# Hard session cap in USD; 0 = no cap. Server refuses new runs when reached.
# Restart the server to reset the session counter.
# SESSION_CAP_USD=10

# Web search controls. Lower = cheaper, less thorough. Default 10.
# WEB_SEARCH_MAX_USES=10

# Output token cap per run. Default 3000.
# MAX_TOKENS=3000

# External API leads (queried before each run, results merged into KB context
# as Tier 3 leads). Per-source disable flags; cache TTL is per-individual.
#
# FamilySearch Tree Person Search — API access was declined for personal-use
# applications on 2026-05-01 (ticket 2663032). Code is retained but gated
# off. Do not unset this without a fresh, business-framed application; see
# agent/apiClients/familySearchClient.js header for context.
FAMILYSEARCH_DISABLE=1
#
# WikiTree public read API — no credentials needed for public profiles.
# WIKITREE_DISABLE=1
#
# TNA Discovery (UK National Archives catalogue) — no credentials needed.
# TNA_DISCOVERY_DISABLE=1
#
# Cache window per individual in days. Default 30. Set to 0 to force refresh
# on every run (useful for debugging — burns API quota).
# EXTERNAL_API_CACHE_DAYS=30

# Folder paths for the document and story ingestion pipeline. Default to
# ./ingest/documents and ./ingest/stories under the project root. Override
# to point at a folder anywhere on disk (e.g. iCloud / Dropbox sync).
# INGEST_DOCUMENTS_DIR=/Users/you/genealogy-docs
# INGEST_STORIES_DIR=/Users/you/genealogy-stories
